{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "WebApp1",
    "Audience": "WebApp1Client",
    "AccessTokenLifetimeMinutes": 15
  },
  "RefreshToken": {
    "TokenLifetimeDays": 30,
    "GraceTimeSeconds": 20
  },
  "Storage": {
    "RootPath": "storage"
  },
  "ConfirmationToken": {
    "EmailChangeLifetimeMinutes": 60,
    "EmailConfirmationLifetimeHours": 24,
    "PasswordResetLifetimeMinutes": 30
  }
}
